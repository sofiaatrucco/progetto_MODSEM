###  http://www.semanticweb.org/sofia/ontologies/2026/acio/ZonaExtraSchengen
:ZonaExtraSchengen rdf:type owl:NamedIndividual ,
                            :ZonaDoganale ,
                            [ rdf:type owl:Class ;
                              owl:oneOf ( :ZonaExtraSchengen
                                          :ZonaSchengen
                                          :ZonaTransito
                                        )
                            ] ;
                   rdfs:comment "Airport customs zone dedicated to flights to or from countries outside the Schengen area."@en ,
                                "Zona doganale aeroportuale dedicata ai voli con destinazione o provenienza da paesi fuori dall'area Schengen."@it ;
                   rdfs:label "Extra-Schengen Zone"@en ,
                              "ZonaExtraSchengen"@it .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/ZonaSchengen
:ZonaSchengen rdf:type owl:NamedIndividual ,
                       :ZonaDoganale ,
                       [ rdf:type owl:Class ;
                         owl:oneOf ( :ZonaExtraSchengen
                                     :ZonaSchengen
                                     :ZonaTransito
                                   )
                       ] ;
              rdfs:comment "Airport customs zone dedicated to flights within the Schengen area, without customs controls."@en ,
                           "Zona doganale aeroportuale dedicata ai voli interni all'area Schengen, senza controlli doganali."@it ;
              rdfs:label "Schengen Zone"@en ,
                         "ZonaSchengen"@it .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/ZonaTransito
:ZonaTransito rdf:type owl:NamedIndividual ,
                       :ZonaDoganale ,
                       [ rdf:type owl:Class ;
                         owl:oneOf ( :ZonaExtraSchengen
                                     :ZonaSchengen
                                     :ZonaTransito
                                   )
                       ] ;
              rdfs:comment "Airport customs zone reserved for transit passengers who do not enter national territory."@en ,
                           "Zona doganale aeroportuale riservata ai passeggeri in transito che non entrano nel territorio nazionale."@it ;
              rdfs:label "Transit Zone"@en ,
                         "ZonaTransito"@it .


#################################################################
#    General axioms
#################################################################

[ owl:intersectionOf ( :Aeroporto
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :haTerminal ;
                         owl:someValuesFrom [ owl:intersectionOf ( :Terminal
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty :haDogana ;
                                                                     owl:someValuesFrom :Dogana
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ]
                       ]
                     ) ;
  rdf:type owl:Class ;
  rdfs:subClassOf :Aeroporto
] .


[ owl:intersectionOf ( :Aeroporto
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :haTerminal ;
                         owl:someValuesFrom [ owl:intersectionOf ( :Terminal
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty :haDogana ;
                                                                     owl:someValuesFrom :Dogana
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ]
                       ]
                     ) ;
  rdf:type owl:Class ;
  rdfs:subClassOf :AeroportoConDogana
] .


[ owl:intersectionOf ( :Aeroporto
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :haTerminal ;
                         owl:someValuesFrom [ owl:intersectionOf ( :Terminal
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty :haDogana ;
                                                                     owl:someValuesFrom :Dogana
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ]
                       ]
                     ) ;
  rdf:type owl:Class ;
  rdfs:subClassOf [ rdf:type owl:Restriction ;
                    owl:onProperty :haTerminal ;
                    owl:someValuesFrom [ owl:intersectionOf ( :Terminal
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty :haDogana ;
                                                                owl:someValuesFrom :Dogana
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ]
                  ]
] .


[ owl:intersectionOf ( :Aeroporto
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :haTerminal ;
                         owl:someValuesFrom [ owl:intersectionOf ( :Terminal
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty :haDogana ;
                                                                     owl:someValuesFrom :Dogana
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ]
                       ]
                     ) ;
  rdf:type owl:Class ;
  rdfs:subClassOf [ rdf:type owl:Restriction ;
                    owl:onProperty :haPista ;
                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                    owl:onClass :Pista
                  ]
] .


[ owl:intersectionOf ( :Aeroporto
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :haTerminal ;
                         owl:someValuesFrom [ owl:intersectionOf ( :Terminal
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty :haDogana ;
                                                                     owl:someValuesFrom :Dogana
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ]
                       ]
                     ) ;
  rdf:type owl:Class ;
  rdfs:subClassOf [ rdf:type owl:Restriction ;
                    owl:onProperty :haTerminal ;
                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                    owl:onClass :Terminal
                  ]
] .


[ owl:intersectionOf ( :Aeroporto
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :haTerminal ;
                         owl:someValuesFrom [ owl:intersectionOf ( :Terminal
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty :haDogana ;
                                                                     owl:someValuesFrom :Dogana
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ]
                       ]
                     ) ;
  rdf:type owl:Class ;
