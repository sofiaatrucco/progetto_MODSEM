@prefix : <http://www.semanticweb.org/sofia/ontologies/2026/acio/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix schema: <https://schema.org/> .
@base <http://www.semanticweb.org/sofia/ontologies/2026/acio/> .

<http://www.semanticweb.org/sofia/ontologies/2026/acio> rdf:type owl:Ontology ;
                                                         dc:creator "Olivero Matteo"@it ,
                                                                    "Trucco Sofia"@it ;
                                                         dc:date "2026"^^xsd:gYear ;
                                                         dc:description "Ontologia per la descrizione semantica delle infrastrutture aeroportuali, dei servizi offerti e dei collegamenti aerei. Modella aeroporti come hub logistici con capacità operative, ruoli istituzionali e vincoli regolatori."@it ,
                                                                        "Ontology for the semantic description of airport infrastructures, offered services and air connections. Models airports as logistic hubs with operational capacities, institutional roles and regulatory constraints."@en ;
                                                         dc:title "Airport Connectivity & Infrastructure Ontology"@en ,
                                                                  "Airport Connectivity & Infrastructure Ontology"@it ;
                                                         vann:preferredNamespacePrefix "acio" ;
                                                         vann:preferredNamespaceUri "http://www.semanticweb.org/sofia/ontologies/2026/acio/" ;
                                                         rdfs:comment """L'ontologia ACIO (Airport Connectivity & Infrastructure Ontology) fornisce una struttura 
formale per la descrizione semantica delle infrastrutture aeroportuali, dei servizi offerti 
e dei collegamenti aerei. Modella l'aeroporto come hub logistico caratterizzato da capacità operative, ruoli istituzionali e vincoli regolatori. Il dominio copre entità fisiche, organizzative ed eventi. L'ontologia supporta task di consultazione, catalogazione, 
verifica di vincoli operativi."""@it ,
                                                                      "The ACIO (Airport Connectivity & Infrastructure Ontology) provides a formal structure for the semantic description of airport infrastructures, offered services, and air connections. It models the airport as a logistic hub characterized by operational capacities, institutional roles, and regulatory constraints. The domain covers physical, organizational, and event-based entities. The ontology supports tasks such as querying, cataloguing, and verification of operational constraints."@en ;
                                                         rdfs:label "Airport Connectivity & Infrastructure Ontology (ACIO)"@en ,
                                                                    "Airport Connectivity & Infrastructure Ontology (ACIO)"@it .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/creator
dc:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/date
dc:date rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
dc:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
dc:title rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty .


###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#broadMatch
skos:broadMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#exactMatch
skos:exactMatch rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/sofia/ontologies/2026/acio/arrivaA
:arrivaA rdf:type owl:ObjectProperty ,
                  owl:FunctionalProperty ;
         rdfs:domain :Volo ;
         rdfs:range :Aeroporto ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :haPista ;
                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                      owl:onClass :Pista
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :haTerminal ;
                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                      owl:onClass :Terminal
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :CodiceIATA ;
                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                      owl:onDataRange xsd:string
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :CodiceICAO ;
                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                      owl:onDataRange xsd:string
                    ] ;
         rdfs:comment "Indica l'aeroporto di destinazione di un volo."@it ,
                      "Indicates the destination airport of a flight."@en ;
         rdfs:label "arrivaA"@it ,
                    "arrives at"@en .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/cittàInNazione
:cittàInNazione rdf:type owl:ObjectProperty ;
                rdfs:domain :Città ;
                rdfs:range :Nazione ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :CodiceISO ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:string
                           ] ;
                rdfs:comment "Indica la nazione in cui si trova una città."@it ,
                             "Indicates the nation in which a city is located."@en ;
                rdfs:label "cittàInNazione"@it ,
                           "city in nation"@en .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/collegatoCon
:collegatoCon rdf:type owl:ObjectProperty ,
                       owl:TransitiveProperty ;
              rdfs:domain :Aeroporto ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :haPista ;
                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :Pista
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :haTerminal ;
                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :Terminal
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :CodiceIATA ;
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onDataRange xsd:string
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :CodiceICAO ;
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onDataRange xsd:string
                          ] ;
              rdfs:range :Aeroporto ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :haPista ;
                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Pista
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :haTerminal ;
                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Terminal
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :CodiceIATA ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onDataRange xsd:string
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :CodiceICAO ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onDataRange xsd:string
                         ] ;
              rdfs:comment "Indica che un aeroporto è collegato con un altro tramite voli diretti. Proprietà transitiva."@it ,
                           "Indicates that an airport is connected to another via direct flights. Transitive property."@en ;
              rdfs:label "collegatoCon"@it ,
                         "connected with"@en .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/gestisce
:gestisce rdf:type owl:ObjectProperty ;
          owl:inverseOf :gestitoDa ;
          rdfs:domain :AutoritàAeroportuale ;
          rdfs:range :Aeroporto ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :haPista ;
                       owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                       owl:onClass :Pista
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :haTerminal ;
                       owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                       owl:onClass :Terminal
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :CodiceIATA ;
                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                       owl:onDataRange xsd:string
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :CodiceICAO ;
                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                       owl:onDataRange xsd:string
                     ] ;
          rdfs:comment "Indica che un'autorità aeroportuale gestisce un aeroporto."@it ,
                       "Indicates that an airport authority manages an airport."@en ;
          rdfs:label "gestisce"@it ,
                     "manages"@en .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/gestitoDa
:gestitoDa rdf:type owl:ObjectProperty ;
           rdfs:domain :Aeroporto ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :haPista ;
                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :Pista
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :haTerminal ;
                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :Terminal
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :CodiceIATA ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange xsd:string
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :CodiceICAO ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange xsd:string
                       ] ;
           rdfs:range :AutoritàAeroportuale ;
           rdfs:comment "Indica l'autorità aeroportuale che gestisce un aeroporto."@it ,
                        "Indicates the airport authority that manages an airport."@en ;
           rdfs:label "gestitoDa"@it ,
                      "managed by"@en .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/haDogana
:haDogana rdf:type owl:ObjectProperty ;
          rdfs:domain :Terminal ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :haGate ;
                        owl:someValuesFrom :Gate
                      ] ;
          rdfs:range :Dogana ;
          rdfs:comment "Indica che un terminal dispone di un ufficio doganale."@it ,
                       "Indicates that a terminal has a customs office."@en ;
          rdfs:label "haDogana"@it ,
                     "has customs"@en .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/haGate
:haGate rdf:type owl:ObjectProperty ;
        rdfs:domain :Terminal ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :haGate ;
                      owl:someValuesFrom :Gate
                    ] ;
        rdfs:range :Gate ;
        rdfs:comment "Indica che un terminal è dotato di uno o più gate di imbarco."@it ,
                     "Indicates that a terminal has one or more boarding gates."@en ;
        rdfs:label "haGate"@it ,
                   "has gate"@en .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/haLounge
:haLounge rdf:type owl:ObjectProperty ;
          rdfs:domain :Terminal ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :haGate ;
                        owl:someValuesFrom :Gate
                      ] ;
          rdfs:range :Lounge ;
          rdfs:comment "Indica che un terminal dispone di una lounge passeggeri."@it ,
                       "Indicates that a terminal has a passenger lounge."@en ;
          rdfs:label "haLounge"@it ,
                     "has lounge"@en .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/haPista
:haPista rdf:type owl:ObjectProperty ;
         rdfs:domain :Aeroporto ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :haPista ;
                       owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                       owl:onClass :Pista
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :haTerminal ;
                       owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                       owl:onClass :Terminal
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :CodiceIATA ;
                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                       owl:onDataRange xsd:string
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :CodiceICAO ;
                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                       owl:onDataRange xsd:string
                     ] ;
         rdfs:range :Pista ;
         rdfs:comment "Indica che un aeroporto è dotato di una pista di atterraggio/decollo."@it ,
                      "Indicates that an airport has a runway."@en ;
         rdfs:label "haPista"@it ,
                    "has runway"@en .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/haTerminal
:haTerminal rdf:type owl:ObjectProperty ;
            rdfs:domain :Aeroporto ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :haPista ;
                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :Pista
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :haTerminal ;
                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :Terminal
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :CodiceIATA ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onDataRange xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :CodiceICAO ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onDataRange xsd:string
                        ] ;
            rdfs:range :Terminal ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :haGate ;
                         owl:someValuesFrom :Gate
                       ] ;
            rdfs:comment "Indica che un aeroporto è dotato di uno o più terminal passeggeri."@it ,
                         "Indicates that an airport has one or more passenger terminals."@en ;
            rdfs:label "haTerminal"@it ,
                       "has terminal"@en .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/haTipoZona
:haTipoZona rdf:type owl:ObjectProperty ;
            rdfs:domain :Dogana ;
            rdfs:range :ZonaDoganale ,
                       [ rdf:type owl:Class ;
                         owl:oneOf ( :ZonaExtraSchengen
                                     :ZonaSchengen
                                     :ZonaTransito
                                   )
                       ] ;
            rdfs:comment "Indica il tipo di zona doganale associato a un ufficio doganale."@it ,
                         "Indicates the type of customs zone associated with a customs office."@en ;
            rdfs:label "haTipoZona"@it ,
                       "has zone type"@en .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/haVolo
:haVolo rdf:type owl:ObjectProperty ;
        owl:inverseOf :parteDa ;
        rdfs:domain :Aeroporto ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :haPista ;
                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                      owl:onClass :Pista
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :haTerminal ;
                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                      owl:onClass :Terminal
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :CodiceIATA ;
                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                      owl:onDataRange xsd:string
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :CodiceICAO ;
                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                      owl:onDataRange xsd:string
                    ] ;
        rdfs:range :Volo ;
        rdfs:comment "Indica che un aeroporto è aeroporto di partenza di un volo."@it ,
                     "Indicates that an airport is the departure airport of a flight."@en ;
        rdfs:label "haVolo"@it ,
                   "has flight"@en .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/operaIn
:operaIn rdf:type owl:ObjectProperty ;
         rdfs:domain :CompagniaAerea ;
         rdfs:range :Aeroporto ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :haPista ;
                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                      owl:onClass :Pista
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :haTerminal ;
                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                      owl:onClass :Terminal
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :CodiceIATA ;
                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                      owl:onDataRange xsd:string
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :CodiceICAO ;
                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                      owl:onDataRange xsd:string
                    ] ;
         owl:propertyChainAxiom ( :voloOperatoDa
                                  :parteDa
                                ) ;
         rdfs:comment "Indica che una compagnia aerea opera in un determinato aeroporto. Derivata tramite catena di proprietà: inverso di operatoDa seguito da parteDa."@it ,
                      "Indicates that an airline operates in a given airport. Derived via property chain: inverse of operatoDa followed by parteDa."@en ;
         rdfs:label "operaIn"@it ,
                    "operates in"@en .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/operatoDa
:operatoDa rdf:type owl:ObjectProperty ;
           owl:inverseOf :voloOperatoDa ;
           rdf:type owl:FunctionalProperty ;
           rdfs:domain :Volo ;
           rdfs:range :CompagniaAerea ;
           rdfs:comment "Indica la compagnia aerea che opera un determinato volo."@it ,
                        "Indicates the airline that operates a given flight."@en ;
           rdfs:label "operated by"@en ,
                      "operatoDa"@it .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/parteDa
:parteDa rdf:type owl:ObjectProperty ,
                  owl:FunctionalProperty ;
         rdfs:domain :Volo ;
         rdfs:range :Aeroporto ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :haPista ;
                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                      owl:onClass :Pista
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :haTerminal ;
                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                      owl:onClass :Terminal
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :CodiceIATA ;
                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                      owl:onDataRange xsd:string
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :CodiceICAO ;
                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                      owl:onDataRange xsd:string
                    ] ;
         rdfs:comment "Indica l'aeroporto di partenza di un volo."@it ,
                      "Indicates the departure airport of a flight."@en ;
         rdfs:label "departs from"@en ,
                    "parteDa"@it .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/situatoIn
:situatoIn rdf:type owl:ObjectProperty ;
           rdfs:domain :Aeroporto ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :haPista ;
                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :Pista
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :haTerminal ;
                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :Terminal
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :CodiceIATA ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange xsd:string
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :CodiceICAO ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange xsd:string
                       ] ;
           rdfs:range :Nazione ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :CodiceISO ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onDataRange xsd:string
                      ] ;
           owl:propertyChainAxiom ( :situatoInCittà
                                    :cittàInNazione
                                  ) ;
           rdfs:comment "Indica la nazione in cui è situato un aeroporto. Derivata tramite catena: situatoInCittà seguito da cittàInNazione."@it ,
                        "Indicates the nation in which an airport is located. Derived via chain: situatoInCittà followed by cittàInNazione."@en ;
           rdfs:label "located in"@en ,
                      "situatoIn"@it .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/situatoInCittà
:situatoInCittà rdf:type owl:ObjectProperty ;
                rdfs:domain :Aeroporto ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :haPista ;
                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :Pista
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :haTerminal ;
                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :Terminal
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :CodiceIATA ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onDataRange xsd:string
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :CodiceICAO ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onDataRange xsd:string
                            ] ;
                rdfs:range :Città ;
                rdfs:comment "Indica la città in cui è situato un aeroporto."@it ,
                             "Indicates the city in which an airport is located."@en ;
                rdfs:label "located in city"@en ,
                           "situatoInCittà"@it .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/voloOperatoDa
:voloOperatoDa rdf:type owl:ObjectProperty ;
               rdfs:domain :CompagniaAerea ;
               rdfs:range :Volo ;
               rdfs:comment "Inverse property of operatoDa. Indicates the flights operated by an airline."@en ,
                            "Proprietà inversa di operatoDa. Indica i voli operati da una compagnia aerea."@it ;
               rdfs:label "flight operated by"@en ,
                          "voloOperatoDa"@it .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/sofia/ontologies/2026/acio/AnnoApertura
:AnnoApertura rdf:type owl:DatatypeProperty ;
              rdfs:domain :Aeroporto ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :haPista ;
                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :Pista
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :haTerminal ;
                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :Terminal
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :CodiceIATA ;
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onDataRange xsd:string
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :CodiceICAO ;
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onDataRange xsd:string
                          ] ;
              rdfs:range xsd:gYear ;
              rdfs:comment "Anno di apertura dell'aeroporto."@it ,
                           "Year of opening of the airport."@en ;
              rdfs:label "AnnoApertura"@it ,
                         "opening year"@en .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/CodiceIATA
:CodiceIATA rdf:type owl:DatatypeProperty ;
            rdfs:domain :Aeroporto ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :haPista ;
                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :Pista
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :haTerminal ;
                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :Terminal
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :CodiceIATA ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onDataRange xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :CodiceICAO ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onDataRange xsd:string
                        ] ;
            rdfs:range xsd:string ;
            rdfs:comment "Codice identificativo IATA a tre lettere dell'aeroporto."@it ,
                         "Three-letter IATA identification code of the airport."@en ;
            rdfs:label "CodiceIATA"@it ,
                       "IATA code"@en .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/CodiceICAO
:CodiceICAO rdf:type owl:DatatypeProperty ;
            rdfs:domain :Aeroporto ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :haPista ;
                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :Pista
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :haTerminal ;
                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :Terminal
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :CodiceIATA ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onDataRange xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :CodiceICAO ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onDataRange xsd:string
                        ] ;
            rdfs:range xsd:string ;
            rdfs:comment "Codice identificativo ICAO a quattro lettere dell'aeroporto."@it ,
                         "Four-letter ICAO identification code of the airport."@en ;
            rdfs:label "CodiceICAO"@it ,
                       "ICAO code"@en .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/CodiceISO
:CodiceISO rdf:type owl:DatatypeProperty ;
           rdfs:domain :Nazione ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :CodiceISO ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange xsd:string
                       ] ;
           rdfs:range xsd:string ;
           rdfs:comment "Codice ISO della nazione."@it ,
                        "ISO code of the nation."@en ;
           rdfs:label "CodiceISO"@it ,
                      "ISO code"@en .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/InZonaSchengen
:InZonaSchengen rdf:type owl:DatatypeProperty ;
                rdfs:domain :Nazione ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :CodiceISO ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onDataRange xsd:string
                            ] ;
                rdfs:range xsd:boolean ;
                rdfs:comment "Indica se la nazione fa parte della zona Schengen."@it ,
                             "Indicates whether the nation is part of the Schengen area."@en ;
                rdfs:label "InZonaSchengen"@it ,
                           "in Schengen area"@en .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/LunghezzaMetri
:LunghezzaMetri rdf:type owl:DatatypeProperty ;
                rdfs:domain :Pista ;
                rdfs:range xsd:integer ;
                rdfs:comment "Length of the runway expressed in meters."@en ,
                             "Lunghezza della pista di volo espressa in metri."@it ;
                rdfs:label "LunghezzaMetri"@it ,
                           "length in meters"@en .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/NomeComune
:NomeComune rdf:type owl:DatatypeProperty ;
            rdfs:domain :Città ;
            rdfs:range xsd:string ;
            rdfs:comment "Common name of the city."@en ,
                         "Nome comune della città."@it ;
            rdfs:label "NomeComune"@it ,
                       "common name"@en .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/NomeNazione
:NomeNazione rdf:type owl:DatatypeProperty ;
             rdfs:domain :Nazione ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :CodiceISO ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onDataRange xsd:string
                         ] ;
             rdfs:range xsd:string ;
             rdfs:comment "Name of the nation."@en ,
                          "Nome della nazione."@it ;
             rdfs:label "NomeNazione"@it ,
                        "nation name"@en .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/OrarioPartenzaSchedulato
:OrarioPartenzaSchedulato rdf:type owl:DatatypeProperty ;
                          rdfs:domain :Volo ;
                          rdfs:range xsd:dateTime ;
                          rdfs:comment "Orario di partenza programmato del volo in formato dateTime."@it ,
                                       "Scheduled departure time of the flight in dateTime format."@en ;
                          rdfs:label "OrarioPartenzaSchedulato"@it ,
                                     "scheduled departure time"@en .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/PasseggeriAnnui
:PasseggeriAnnui rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Aeroporto ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :haPista ;
                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :Pista
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :haTerminal ;
                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :Terminal
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :CodiceIATA ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onDataRange xsd:string
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :CodiceICAO ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onDataRange xsd:string
                             ] ;
                 rdfs:range xsd:integer ;
                 rdfs:comment "Number of passengers transiting through the airport in the reference year."@en ,
                              "Numero di passeggeri transitati nell'aeroporto nell'anno di riferimento."@it ;
                 rdfs:label "PasseggeriAnnui"@it ,
                            "annual passengers"@en .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/Popolazione
:Popolazione rdf:type owl:DatatypeProperty ;
             rdfs:domain :Città ;
             rdfs:range xsd:integer ;
             rdfs:comment "Number of inhabitants of the city."@en ,
                          "Numero di abitanti della città."@it ;
             rdfs:label "Popolazione"@it ,
                        "population"@en .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/sofia/ontologies/2026/acio/Aeroporto
:Aeroporto rdf:type owl:Class ;
           rdfs:subClassOf [ rdf:type owl:Restriction ;
                             owl:onProperty :haPista ;
                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :Pista
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :haTerminal ;
                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :Terminal
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :CodiceIATA ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :CodiceICAO ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:string
                           ] ;
           rdfs:comment "Facility for the take-off and landing of aircraft, equipped with at least one terminal, one runway and one gate. Identified by IATA and ICAO codes."@en ,
                        "Struttura adibita al decollo e all'atterraggio di aeromobili, dotata di almeno un terminal, una pista e un gate. Identificata da codice IATA e ICAO."@it ;
           rdfs:label "Aeroporto"@it ,
                      "Airport"@en ;
           skos:exactMatch dbo:Airport ,
                           schema:Airport .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/AeroportoCivile
:AeroportoCivile rdf:type owl:Class ;
                 rdfs:subClassOf :Aeroporto ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :haPista ;
                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :Pista
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :haTerminal ;
                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :Terminal
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :CodiceIATA ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :CodiceICAO ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:string
                                 ] ;
                 rdfs:comment "Aeroporto destinato al traffico civile commerciale e/o privato."@it ,
                              "Airport intended for civil commercial and/or private traffic."@en ;
                 rdfs:label "AeroportoCivile"@it ,
                            "Civil Airport"@en .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/AeroportoConDogana
:AeroportoConDogana rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( :Aeroporto
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty :haTerminal ;
                                                                 owl:someValuesFrom [ owl:intersectionOf ( :Terminal
                                                                                                           [ rdf:type owl:Restriction ;
                                                                                                             owl:onProperty :haDogana ;
                                                                                                             owl:someValuesFrom :Dogana
                                                                                                           ]
                                                                                                         ) ;
                                                                                      rdf:type owl:Class
                                                                                    ]
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] ;
                    rdfs:subClassOf :Aeroporto ,
                                    [ owl:intersectionOf ( :Aeroporto
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :haTerminal ;
                                                             owl:someValuesFrom [ owl:intersectionOf ( :Terminal
                                                                                                       [ rdf:type owl:Restriction ;
                                                                                                         owl:onProperty :haDogana ;
                                                                                                         owl:someValuesFrom :Dogana
                                                                                                       ]
                                                                                                     ) ;
                                                                                  rdf:type owl:Class
                                                                                ]
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :haTerminal ;
                                      owl:someValuesFrom [ owl:intersectionOf ( :Terminal
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty :haDogana ;
                                                                                  owl:someValuesFrom :Dogana
                                                                                ]
                                                                              ) ;
                                                           rdf:type owl:Class
                                                         ]
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :haPista ;
                                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass :Pista
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :haTerminal ;
                                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass :Terminal
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :CodiceIATA ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :CodiceICAO ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] ;
                    rdfs:comment "Aeroporto dotato di almeno una dogana di tipo Extra-Schengen. Utilizzato per classificare i voli extra-Schengen."@it ,
                                 "Airport equipped with at least one Extra-Schengen customs office. Used to classify extra-Schengen flights."@en ;
                    rdfs:label "AeroportoConDogana"@it ,
                               "Airport with Extra-Schengen Customs"@en .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/AeroportoMilitare
:AeroportoMilitare rdf:type owl:Class ;
                   rdfs:subClassOf :Aeroporto ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :haPista ;
                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :Pista
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :haTerminal ;
                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :Terminal
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :CodiceIATA ;
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :CodiceICAO ;
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ;
                   rdfs:comment "Aeroporto destinato esclusivamente o prevalentemente al traffico militare."@it ,
                                "Airport intended exclusively or mainly for military traffic."@en ;
                   rdfs:label "AeroportoMilitare"@it ,
                              "Military Airport"@en .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/AutoritàAeroportuale
:AutoritàAeroportuale rdf:type owl:Class ;
                      rdfs:comment "Ente o organismo responsabile della gestione e dell'amministrazione di uno o più aeroporti."@it ,
                                   "Entity or body responsible for the management and administration of one or more airports."@en ;
                      rdfs:label "Airport Authority"@en ,
                                 "AutoritàAeroportuale"@it .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/Città
:Città rdf:type owl:Class ;
       rdfs:comment "Centro urbano in cui può essere situato un aeroporto."@it ,
                    "Urban centre in which an airport may be located."@en ;
       rdfs:label "Città"@it ,
                  "City"@en ;
       skos:exactMatch dbo:City ,
                       schema:City .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/CompagniaAerea
:CompagniaAerea rdf:type owl:Class ;
                rdfs:comment "Air carrier that operates one or more commercial flights."@en ,
                             "Vettore aereo che opera uno o più voli commerciali."@it ;
                rdfs:label "Airline"@en ,
                           "CompagniaAerea"@it ;
                skos:exactMatch dbo:Airline ,
                                schema:Airline .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/Dogana
:Dogana rdf:type owl:Class ;
        rdfs:comment "Customs office present in an airport terminal, responsible for controlling goods and passengers entering or leaving the national territory."@en ,
                     "Ufficio doganale presente in un terminal aeroportuale, responsabile del controllo di merci e passeggeri in ingresso o uscita dal territorio nazionale."@it ;
        rdfs:label "Customs"@en ,
                   "Dogana"@it .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/Gate
:Gate rdf:type owl:Class ;
      rdfs:comment "Boarding gate of an airport terminal from which passengers access the aircraft."@en ,
                   "Uscita di imbarco di un terminal aeroportuale da cui i passeggeri accedono all'aeromobile."@it ;
      rdfs:label "Gate"@en ,
                 "Gate"@it .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/HubAeroportuale
:HubAeroportuale rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( :Aeroporto
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty [ owl:inverseOf :parteDa
                                                                             ] ;
                                                              owl:someValuesFrom :VoloInternazionale
                                                            ]
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty :haPista ;
                                                              owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                                              owl:onClass :Pista
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ;
                 rdfs:subClassOf :Aeroporto ,
                                 [ owl:intersectionOf ( :Aeroporto
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty [ owl:inverseOf :parteDa
                                                                         ] ;
                                                          owl:someValuesFrom :VoloInternazionale
                                                        ]
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :haPista ;
                                                          owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                                          owl:onClass :Pista
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty [ owl:inverseOf :parteDa
                                                  ] ;
                                   owl:someValuesFrom :VoloInternazionale
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :haPista ;
                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :Pista
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :haPista ;
                                   owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                   owl:onClass :Pista
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :haTerminal ;
                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :Terminal
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :CodiceIATA ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :CodiceICAO ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:string
                                 ] ;
                 rdfs:comment "Aeroporto che funge da nodo principale per i voli internazionali, dotato di almeno due piste."@it ,
                              "Airport that acts as a main hub for international flights, equipped with at least two runways."@en ;
                 rdfs:label "Airport Hub"@en ,
                            "HubAeroportuale"@it .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/Lounge
:Lounge rdf:type owl:Class ;
        rdfs:comment "Sala d'attesa riservata ai passeggeri, tipicamente a pagamento o ad accesso selezionato, presente in un terminal aeroportuale."@it ,
                     "Waiting room reserved for passengers, typically paid or selectively accessed, located in an airport terminal."@en ;
        rdfs:label "Lounge"@en ,
                   "Lounge"@it ;
        skos:broadMatch schema:LodgingBusiness .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/Nazione
:Nazione rdf:type owl:Class ;
         rdfs:subClassOf [ rdf:type owl:Restriction ;
                           owl:onProperty :CodiceISO ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onDataRange xsd:string
                         ] ;
         rdfs:comment "Entità geografico-politica sovrana in cui può essere situato un aeroporto o una città."@it ,
                      "Sovereign geographical-political entity in which an airport or city may be located."@en ;
         rdfs:label "Nation"@en ,
                    "Nazione"@it ;
         skos:exactMatch dbo:Country ,
                         schema:Country .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/Pista
:Pista rdf:type owl:Class ;
       rdfs:comment "Pista di decollo e atterraggio di un aeroporto, caratterizzata da una lunghezza espressa in metri."@it ,
                    "Take-off and landing runway of an airport, characterised by a length expressed in metres."@en ;
       rdfs:label "Pista"@it ,
                  "Runway"@en .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/Terminal
:Terminal rdf:type owl:Class ;
          rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty :haGate ;
                            owl:someValuesFrom :Gate
                          ] ;
          rdfs:comment "Airport building for passenger reception and boarding, equipped with at least one gate."@en ,
                       "Edificio aeroportuale destinato all'accoglienza e all'imbarco dei passeggeri, dotato di almeno un gate."@it ;
          rdfs:label "Terminal"@en ,
                     "Terminal"@it ;
          skos:exactMatch schema:AirportTerminal .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/Volo
:Volo rdf:type owl:Class ;
      rdfs:comment "Air transport service connecting a departure airport to a destination airport, operated by an airline."@en ,
                   "Servizio di trasporto aereo che collega un aeroporto di partenza a uno di destinazione, operato da una compagnia aerea."@it ;
      rdfs:label "Flight"@en ,
                 "Volo"@it ;
      skos:exactMatch schema:Flight .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/VoloExtraSchengen
:VoloExtraSchengen rdf:type owl:Class ;
                   owl:equivalentClass [ owl:intersectionOf ( :VoloInternazionale
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty :arrivaA ;
                                                                owl:someValuesFrom [ owl:intersectionOf ( :Aeroporto
                                                                                                          [ rdf:type owl:Restriction ;
                                                                                                            owl:onProperty :haTerminal ;
                                                                                                            owl:someValuesFrom [ owl:intersectionOf ( :Terminal
                                                                                                                                                      [ rdf:type owl:Restriction ;
                                                                                                                                                        owl:onProperty :haDogana ;
                                                                                                                                                        owl:someValuesFrom [ owl:intersectionOf ( :Dogana
                                                                                                                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                                                                                                                    owl:onProperty :haTipoZona ;
                                                                                                                                                                                                    owl:hasValue :ZonaExtraSchengen
                                                                                                                                                                                                  ]
                                                                                                                                                                                                ) ;
                                                                                                                                                                             rdf:type owl:Class
                                                                                                                                                                           ]
                                                                                                                                                      ]
                                                                                                                                                    ) ;
                                                                                                                                 rdf:type owl:Class
                                                                                                                               ]
                                                                                                          ]
                                                                                                        ) ;
                                                                                     rdf:type owl:Class
                                                                                   ]
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                   rdfs:subClassOf :Volo ,
                                   :VoloInternazionale ,
                                   [ owl:intersectionOf ( :VoloInternazionale
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :arrivaA ;
                                                            owl:someValuesFrom [ owl:intersectionOf ( :Aeroporto
                                                                                                      [ rdf:type owl:Restriction ;
                                                                                                        owl:onProperty :haTerminal ;
                                                                                                        owl:someValuesFrom [ owl:intersectionOf ( :Terminal
                                                                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                                                                    owl:onProperty :haDogana ;
                                                                                                                                                    owl:someValuesFrom [ owl:intersectionOf ( :Dogana
                                                                                                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                                                                                                owl:onProperty :haTipoZona ;
                                                                                                                                                                                                owl:hasValue :ZonaExtraSchengen
                                                                                                                                                                                              ]
                                                                                                                                                                                            ) ;
                                                                                                                                                                         rdf:type owl:Class
                                                                                                                                                                       ]
                                                                                                                                                  ]
                                                                                                                                                ) ;
                                                                                                                             rdf:type owl:Class
                                                                                                                           ]
                                                                                                      ]
                                                                                                    ) ;
                                                                                 rdf:type owl:Class
