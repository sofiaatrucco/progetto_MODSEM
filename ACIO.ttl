###  http://www.semanticweb.org/sofia/ontologies/2026/acio/VoloInternazionale
:VoloInternazionale rdf:type owl:Class ;
                    rdfs:subClassOf :Volo ;
                    rdfs:comment "Flight connecting airports located in different countries."@en ,
                                 "Volo che collega aeroporti situati in nazioni diverse."@it ;
                    rdfs:label "International Flight"@en ,
                               "VoloInternazionale"@it .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/VoloInterno
:VoloInterno rdf:type owl:Class ;
             rdfs:subClassOf :Volo ;
             rdfs:comment "Flight connecting two airports located in the same country."@en ,
                          "Volo che collega due aeroporti situati nella stessa nazione."@it ;
             rdfs:label "Domestic Flight"@en ,
                        "VoloInterno"@it .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/VoloSchengen
:VoloSchengen rdf:type owl:Class ;
              rdfs:subClassOf :Volo ,
                              :VoloInternazionale ;
              rdfs:comment "International flight between countries belonging to the Schengen area, without customs controls at internal borders."@en ,
                           "Volo internazionale tra paesi appartenenti alla zona Schengen, senza controlli doganali alle frontiere interne."@it ;
              rdfs:label "Schengen Flight"@en ,
                         "VoloSchengen"@it .


###  http://www.semanticweb.org/sofia/ontologies/2026/acio/ZonaDoganale
:ZonaDoganale rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Class ;
                                    owl:oneOf ( :ZonaExtraSchengen
                                                :ZonaSchengen
                                                :ZonaTransito
                                              )
                                  ] ;
              rdfs:subClassOf [ rdf:type owl:Class ;
                                owl:oneOf ( :ZonaExtraSchengen
                                            :ZonaSchengen
                                            :ZonaTransito
                                          )
                              ] ;
              rdfs:comment "Tipo di zona doganale aeroportuale. Può essere Schengen, Extra-Schengen o Transito. Definita per enumerazione."@it ,
                           "Type of airport customs zone. Can be Schengen, Extra-Schengen or Transit. Defined by enumeration."@en ;
              rdfs:label "Customs Zone"@en ,
                         "ZonaDoganale"@it .


